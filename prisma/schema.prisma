generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Profile {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String

  profileSkills      ProfileSkill[]
  profileExperiences ProfileExperience[]
  profileProjects    ProfileProject[]
}

model ProfileSkill {
  profileId Int
  skillId   Int

  profile Profile @relation(fields: [profileId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  level SkillLevel

  @@id([profileId, skillId])
}

model Skill {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  profileSkills ProfileSkill[]
}

model ProfileExperience {
  profileId Int
  companyId Int

  title       String
  description String
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)

  profile Profile @relation(fields: [profileId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@id([profileId, companyId])
}

model Company {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String

  profileExperiences ProfileExperience[]
}

model ProfileProject {
  id Int @id @default(autoincrement())

  profileId Int

  title       String
  description String?
  url         String?
  repoUrl     String[] @default([])

  profile Profile @relation(fields: [profileId], references: [id])
}
